# Build output — generated by `npm run build`, deployed to Cloudflare, never committed
/dist/

# Dependencies
/node_modules/

# Playwright UI test artifacts — regenerated by `npm run test:ui`
/test-results/
/playwright-report/
/playwright/.cache/

# Logs and OS/editor cruft
npm-debug.log*
.DS_Store
Thumbs.db
.vscode/
.idea/

# Private config/secrets — defensive exclusion; none currently exist in
# this repo, but any future .env file must never be committed.
.env
.env.*
!.env.example
