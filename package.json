{
  "name": "maven-consultancy-website",
  "version": "1.0.0",
  "private": true,
  "description": "Static website for Maven Consultancy Services Pvt. Ltd. Content lives in content/site.yaml; run 'npm run build' to regenerate the HTML pages in dist/.",
  "scripts": {
    "build": "node build.js && node scripts/generate-responsive-images.js",
    "test": "node --test",
    "test:syntax": "node scripts/check-syntax.js",
    "test:ui": "playwright test --project=chromium",
    "test:ui:all": "playwright test",
    "test:ui:install-browsers": "playwright install chromium firefox webkit",
    "test:ui:report": "playwright show-report",
    "test:db": "node tests/db/run.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "js-yaml": "^5.4.1",
    "marked": "^18.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "sharp": "^0.35.3",
    "wrangler": "4.119.0"
  },
  "overrides": {
    "undici": "^7.29.0"
  }
}
